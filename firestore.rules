rules_version = '2';
// กฎความปลอดภัยของฐานข้อมูล Firestore สำหรับเว็บ 0113131 Tatabahasa Bahasa Melayu
// วิธีใช้: คัดลอกทั้งไฟล์นี้ไปวางที่ Firebase Console → Firestore → แท็บ Rules แล้วกด Publish
// - นิสิตอ่านและเขียนได้เฉพาะข้อมูลของตัวเอง
// - คำตอบรายข้อเพิ่มได้อย่างเดียว แก้ไขหรือลบไม่ได้ (ข้อมูลวิจัยจึงไม่ถูกเปลี่ยนภายหลัง)
// - อาจารย์ (อีเมลในฟังก์ชัน isGuru) อ่านข้อมูลของนิสิตทุกคนได้
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // ข้อมูลนิสิต: รหัส (5–15 ตัว) กลุ่มเรียน และชื่อ-สกุล
    function profilSah(p) {
      return p is map
        && p.keys().hasOnly(['no', 'kumpulan', 'namaPenuh', 'masa'])
        && p.no is string && p.no.matches('^[0-9A-Za-z-]{5,15}$')
        && p.kumpulan in ['S101', 'S102', 'S103', 'S104']
        && p.namaPenuh is string && p.namaPenuh.size() > 0 && p.namaPenuh.size() <= 120
        && p.masa is timestamp;
    }
    function isGuru() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['salaebing@gmail.com', 'smuhammad@tsu.ac.th'];
    }

    match /pelajar/{uid} {
      allow read: if isOwner(uid) || isGuru();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nama', 'emel', 'setuju', 'done', 'skor', 'akhir', 'dicipta', 'kemaskini', 'profil', 'sijil'])
        && request.resource.data.emel == request.auth.token.email
        && (!('profil' in request.resource.data) || profilSah(request.resource.data.profil))
        && (!('sijil' in request.resource.data) || (request.resource.data.sijil is map
            && request.resource.data.sijil.keys().hasOnly(['kod', 'masa'])
            && request.resource.data.sijil.kod is string && request.resource.data.sijil.kod.size() <= 40));
      allow delete: if false;

      // สมุดคำศัพท์ส่วนตัว: นิสิตเพิ่ม แก้ ลบของตัวเองได้ อาจารย์อ่านได้
      match /kata/{id} {
        allow read: if isOwner(uid) || isGuru();
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['kata', 'makna', 'nota', 'ayat', 'bab', 'hafal', 'ulang', 'masa', 'kemaskini'])
          && request.resource.data.kata is string && request.resource.data.kata.size() > 0 && request.resource.data.kata.size() <= 60
          && request.resource.data.makna is string && request.resource.data.makna.size() <= 300
          && request.resource.data.nota is string && request.resource.data.nota.size() <= 500
          && request.resource.data.ayat is string && request.resource.data.ayat.size() <= 300;
        allow delete: if isOwner(uid);
      }

      match /jawapan/{id} {
        allow read: if isOwner(uid) || isGuru();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['bab', 'laluan', 'jenis', 'latihan', 'item', 'soalan', 'jawapan', 'betul', 'masa'])
          && request.resource.data.soalan is string && request.resource.data.soalan.size() <= 300
          && request.resource.data.jawapan is string && request.resource.data.jawapan.size() <= 300
          && request.resource.data.masa == request.time;
        allow update, delete: if false;
      }
    }

    // ตารางอันดับ: เข้าร่วมโดยสมัครใจ ใช้ชื่อเล่น ทุกคนที่ล็อกอินอ่านได้ เจ้าของแก้ไขของตัวเอง อาจารย์ลบได้ (กรณีชื่อเล่นไม่เหมาะสม)
    match /peringkat/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['gelaran', 'kumpulan', 'mata', 'bab', 'betul', 'kemaskini'])
        && request.resource.data.gelaran is string && request.resource.data.gelaran.size() >= 2 && request.resource.data.gelaran.size() <= 24
        && request.resource.data.kumpulan is string && request.resource.data.kumpulan.size() <= 8
        && request.resource.data.mata is int && request.resource.data.mata >= 0 && request.resource.data.mata <= 6000
        && request.resource.data.bab is int && request.resource.data.bab >= 0 && request.resource.data.bab <= 13
        && request.resource.data.betul is int && request.resource.data.betul >= 0 && request.resource.data.betul <= 2000
        && request.resource.data.kemaskini == request.time;
      allow delete: if isOwner(uid) || isGuru();
    }

    // ทุกอย่างนอกเหนือจากนี้ปิดไว้
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
